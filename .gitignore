__pycache__/
*.pyc

# ── 编辑器 / 系统杂物 ──────────────────────────────────────────────
*.swp
*~
.DS_Store

# ── 实验运行日志（是本机运行产物，**不入库**）─────────────────────────
# 各 lab 的 run.sh 会在自己目录下生成 .out/，里面是本机真实运行输出。
# 仓库只保留源码、文档与 Makefile；需要日志就自己跑一遍 run.sh。
labs/*/.out/

# mok-sign.sh 签名前留下的未签名备份
*.unsigned.bak

# 按 docs/00 的读码方法可能在本仓库里生成的索引文件
cscope.out
cscope.in.out
cscope.po.out
tags
.cscope/
